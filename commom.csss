/* General Postcard Container & Body Styling */
body {
    background-color: #f0ebd8;
    font-family: Arial, sans-serif;
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0;
    padding: 20px;
}

.postcard {
    background-color: #ffffff;
    width: 100%;
    max-width: 700px;
    padding: 30px;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
}

/* Navigation Bar Styling */
.navbar {
    display: flex;
    justify-content: center;
    gap: 15px;
    margin-bottom: 20px;
    padding: 10px;
    background-color: #f4f6f9;
    border-radius: 8px;
}

.navbar a {
    text-decoration: none;
    color: #002b5c;
    font-weight: bold;
    padding: 8px 16px;
    border-radius: 5px;
    transition: background-color 0.3s, color 0.3s;
}

.navbar a:hover {
    background-color: #dce4f0;
}

.navbar a.active {
    background-color: #002b5c;
    color: #ffffff;
}

/* Header Section */
header {
    text-align: center;
    margin-bottom: 20px;
}

header h1 {
    color: #002b5c;
    margin-bottom: 5px;
}

header p {
    color: #666666;
    font-size: 1.1rem;
}

/* Hero Image Section */
.hero img {
    width: 100%;
    height: 350px;
    object-fit: cover;
    border-radius: 8px;
    margin-bottom: 20px;
}

/* Intro & Content Sections */
.intro, .travel-info, .fun-fact {
    margin-bottom: 25px;
}

.intro h2, .travel-info h2, .fun-fact h2 {
    color: #002b5c;
    font-size: 1.3rem;
    margin-bottom: 10px;
}

.intro p, .fun-fact p {
    color: #333333;
    line-height: 1.6;
}

/* Table Styling */
table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 10px;
}

th, td {
    border: 1px solid #ddd;
    padding: 12px;
    text-align: left;
}

th {
    background-color: #002b5c;
    color: white;
}

tr:nth-child(even) {
    background-color: #f9f9f9;
}

/* Interactive Button Styling */
button {
    background-color: #002b5c;
    color: white;
    border: none;
    padding: 10px 20px;
    font-size: 1rem;
    font-weight: bold;
    border-radius: 5px;
    cursor: pointer;
    transition: background-color 0.3s;
    margin-top: 10px;
}

button:hover {
    background-color: #004080;
}

/* Footer Styling */
footer {
    text-align: center;
    margin-top: 30px;
    padding-top: 15px;
    border-top: 1px solid #eee;
    color: #777777;
    font-size: 0.9rem;
}